+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "Decrypt.h"
+
+int main(int argc, char *argv[]) {
+ bool ret = false;
+ char snum[12];
+ 
+
+
+   // To test pass the password in argv
+   if (argc < 2) {
+      printf("Start brute force decrypt with 6 digits\n");
+      // Max 6 digits for pass
+      for (int num=0;num<1000000;num++)
+      {
+         sprintf( snum, "%04d", num );
+
+         // Print our string
+         printf("Try password : %s\n", snum);
+         ret = Decrypt_User(0, snum);
+
+         if (ret) {
+            break;
+         }
+      }
+   }
+   else if (argc < 3) {
+      printf("Decrypt with %s code\n",argv[1]);
+      ret = Decrypt_User(0, argv[1]);
+   }
+      
+   if (!ret) {
+      printf("Failed to decrypt\n");
+      return -1;
+   }
+   else {
+      printf("Password Found\n");
+      return 0;
+   }
+   
+   return 0;
+}
