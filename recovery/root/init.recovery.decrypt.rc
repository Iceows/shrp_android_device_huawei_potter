
on init
    # TEE
    chmod 0400 /dev/hisi_teelog
    chown system system /sys/kernel/tui/c_state
    chmod 0664 /dev/ion
    chown system system /dev/ion
    
    # Keystore
    chown root shell /tmp
    chmod 0775 /tmp
    mkdir /tmp/misc
    mkdir /tmp/misc/keystore/
    chmod 0777 /tmp/misc/
    chmod 0777 /tmp/misc/keystore/

    
on fs
    start fixlinks

    # mount secure storage partition for teeos
    wait /dev/block/by-name/secure_storage
    mount ext4 /dev/block/by-name/secure_storage /sec_storage rw discard,auto_da_alloc,mblk_io_submit,data=journal,context=u:object_r:teecd_data_file:s0
    chown root system /sec_storage
    chmod 0660 /sec_storage

    # restore sepolicy label because teecd check label
    restorecon /vendor/bin/teecd
    restorecon /vendor/bin/hw/vendor.huawei.hardware.libteec@2.0-service
    restorecon /vendor/bin/hw/android.hardware.keymaster@3.0-service
    restorecon /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    
    install_keyring
    
    setprop crypto.ready 1

on post-fs-data
    mkdir /data/sec_storage_data 0700 system system encryption=None
    restorecon /data/sec_storage_data
    
    mkdir /data/sec_storage_data_users 0700 system system encryption=None
    restorecon /data/sec_storage_data_users

    mkdir /data/vendor/log/sec_storage_data 0775 system system
    mkdir /data/vendor/log/sec_storage_data/log 0755 system system

    mkdir /data/vendor/sec_storage_data 0700 system system
    restorecon /data/vendor/sec_storage_data
    
    mkdir /data/vendor/sec_storage_data_users 0700 system system
    restorecon /data/vendor/sec_storage_data_users

on property:crypto.ready=1
    start teecd
    
# && property:hwservicemanager.ready=true is for Oreo+ build trees
# hwservicemanager doesn't exist in older trees
on property:crypto.ready=1 && property:hwservicemanager.ready=true
    start keystore
    start libteec-2-0
    setprop vendor.sys.listeners.registered true

on property:vendor.sys.listeners.registered=true
     start keymaster-3-0
     start gatekeeper-1-0

on property:crypto.ready=0
    stop gatekeeper-1-0
    stop keymaster-3-0
    stop libteec-2-0
    stop keystore
    stop teecd

# For libtee and keymaster
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    override
    class early_hal
    user system
    group system readproc
    disabled

service keymaster-3-0 /vendor/bin/hw/android.hardware.keymaster@3.0-service
    override
    interface android.hardware.keymaster@3.0::IKeymasterDevice default
    class early_hal
    user system
    group system readproc
    disabled

service libteec-2-0 /vendor/bin/hw/vendor.huawei.hardware.libteec@2.0-service
    class early_hal
    user system
    group system readproc
    disabled

service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

# keystore is started and stopped on demand by TWRP
service keystore /system/bin/keystore /tmp/misc/keystore
    user root
    group root system drmrpc readproc log
    disabled
    seclabel u:r:recovery:s0

